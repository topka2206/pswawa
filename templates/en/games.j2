{% extends "base.j2" %}
{% import "macros.j2" as m %}
{% set ps5 = prices.consoles|selectattr("id", "equalto", "ps5")|first %}
{% block sticky_item %}ps5{% endblock %}
{% block main %}
  {{ m.subhero(ui, settings,
     "PS5 games included with your rental",
     "Every game is already on the console's account — nothing to buy, no hours of downloads. Here's what people play most.",
     "i-gamepad", "is-game", "ps5", "Book a PS5",
     extra="PS5 from " ~ (ps5.d1|zl) ~ " zł/day") }}

  {% if settings.blocks.gta %}
  <section class="section section-tight" id="gta-6" aria-labelledby="h-gta">
    <div class="wrap">
      <div class="gta reveal">
        <div class="p-scan" aria-hidden="true"></div>
        <div class="gta-top"><span class="eyebrow is-game">New</span><span class="gta-date">Out {{ settings.gta_release }}</span></div>
        <h2 class="h2" id="h-gta">GTA VI with a PS5 rental</h2>
        <div class="gta-body">
          <p>No need to buy the console or the game: GTA VI will be on our PS5s from day one. Book early.</p>
          {{ m.ig(settings, "PS5 with GTA VI", "ps5", "gta", cls="btn btn-lime", icon=false) }}
          <a class="link-arrow" href="{{ url('gta') }}">GTA VI prices &amp; packages</a>
        </div>
      </div>
    </div>
  </section>
  {% endif %}

  {% for group, label in ui.game_groups.items() %}
  {% set list = games|selectattr("group", "equalto", group)|list %}
  {% if list %}
  <section class="section section-compact" aria-labelledby="h-g-{{ group }}">
    <div class="wrap">
      <h2 class="h2 h2-sm reveal" id="h-g-{{ group }}">{{ label }}</h2>
      {{ m.game_chips(list, settings.gta_release) }}
      {% if group == "vr" %}<p class="games-note reveal">These need the headset — <a href="{{ url('vr') }}">PS VR2 rental</a>.</p>{% endif %}
    </div>
  </section>
  {% endif %}
  {% endfor %}

  <section class="section section-flush" aria-label="Need a specific game">
    <div class="wrap">
      <div class="combo reveal">
        <div class="combo-text">
          <h2 class="h3">Need a specific game?</h2>
          <p>Send us the title in DM — we'll check and get back right away.</p>
        </div>
        {{ m.ig(settings, "Ask about a game", "ps5", "games", icon=false) }}
      </div>
    </div>
  </section>

  {{ m.faq_section(faq, ui) }}

  <section class="section">
    <div class="wrap final reveal">
      <h2 class="h2">Picked a game?</h2>
      <p>We'll bring a PS5 that already has it. <a href="{{ url('consoles') }}">PS5 rental prices</a></p>
      {{ m.ig(settings, ui.book, "ps5", "final") }}
    </div>
  </section>
{% endblock %}
