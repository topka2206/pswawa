{% extends "base.j2" %}
{% import "macros.j2" as m %}
{% set ps5 = prices.consoles|selectattr("id", "equalto", "ps5")|first %}
{% block sticky_item %}ps5{% endblock %}
{% block main %}
  {{ m.subhero(ui, settings,
     "Игры для PS5 в аренду",
     "Все игры уже на аккаунте приставки — ничего не нужно покупать и качать часами. Ниже то, во что играют чаще всего.",
     "i-gamepad", "is-game", "ps5", "Забронировать PS5",
     extra="PS5 — от " ~ (ps5.d1|zl) ~ " zł/сутки") }}

  {% if settings.blocks.gta %}
  <section class="section section-tight" id="gta-6" aria-labelledby="h-gta">
    <div class="wrap">
      <div class="gta reveal">
        <div class="p-scan" aria-hidden="true"></div>
        <div class="gta-top"><span class="eyebrow is-game">Новинка</span><span class="gta-date">Релиз {{ settings.gta_release }}</span></div>
        <h2 class="h2" id="h-gta">GTA VI в аренду с PS5</h2>
        <div class="gta-body">
          <p>Не нужно покупать ни приставку, ни игру: GTA VI будет на наших PS5 с первого дня. Бронируй заранее.</p>
          {{ m.ig(settings, "Хочу PS5 с GTA VI", "ps5", "gta", cls="btn btn-lime", icon=false) }}
          <a class="link-arrow" href="{{ url('gta') }}">Цены и пакеты на GTA VI</a>
        </div>
      </div>
    </div>
  </section>
  {% endif %}

  <!-- Список игр редактируется в админке: «Игры» -->
  {% for group, label in ui.game_groups.items() %}
  {% set list = games|selectattr("group", "equalto", group)|list %}
  {% if list %}
  <section class="section section-compact" aria-labelledby="h-g-{{ group }}">
    <div class="wrap">
      <h2 class="h2 h2-sm reveal" id="h-g-{{ group }}">{{ label }}</h2>
      {{ m.game_chips(list, settings.gta_release) }}
      {% if group == "vr" %}<p class="games-note reveal">Для этих игр нужен шлем — <a href="{{ url('vr') }}">аренда PS VR2</a>.</p>{% endif %}
    </div>
  </section>
  {% endif %}
  {% endfor %}

  <section class="section section-flush" aria-label="Нужна конкретная игра">
    <div class="wrap">
      <div class="combo reveal">
        <div class="combo-text">
          <h2 class="h3">Нужна конкретная игра?</h2>
          <p>Напиши название в Direct — проверим и скажем сразу.</p>
        </div>
        {{ m.ig(settings, "Спросить про игру", "ps5", "games", icon=false) }}
      </div>
    </div>
  </section>

  {{ m.faq_section(faq, ui) }}

  <section class="section">
    <div class="wrap final reveal">
      <h2 class="h2">Выбрал игру?</h2>
      <p>Привезём PS5, на которой она уже стоит. <a href="{{ url('consoles') }}">Цены на аренду PS5</a></p>
      {{ m.ig(settings, ui.book, "ps5", "final") }}
    </div>
  </section>
{% endblock %}
