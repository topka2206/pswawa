{% extends "base.j2" %}
{% import "macros.j2" as m %}
{% set P = prices %}
{% set ps5 = P.consoles|selectattr("id", "equalto", "ps5")|first %}
{% set pro = P.consoles|selectattr("id", "equalto", "ps5pro")|first %}
{% block sticky_item %}ps5{% endblock %}
{% block main %}
  {{ m.subhero(ui, settings,
     "Оренда PS5 з GTA VI у Варшаві",
     "GTA VI виходить " ~ settings.gta_release ~ " — тільки на PS5 і Xbox Series. Не купуй приставку за 2500 zł заради однієї гри: привеземо PS5 з GTA VI додому, підключимо до телевізора й заберемо, коли пройдеш.",
     "i-gamepad", "is-game", "ps5", "Забронювати PS5 з GTA VI",
     extra=("Вихідні з GTA VI — " ~ ((ps5.d2 * 2)|zl) ~ " zł за 2 дні") if ps5.d2 else None) }}

  <!-- ============ ПАКЕТИ ============ -->
  <section class="section section-tight" id="ceny" aria-labelledby="h-packs">
    <div class="wrap">
      {{ m.head("Пакети, zł", "Скільки коштує пограти в GTA VI", "h-packs", "Гра вже на приставці й входить у ціну оренди. Доставка, підключення і 2 геймпади — теж.", cls="is-game") }}
      <div class="models">
        <article class="model reveal is-game"><h3 class="h3">Перший вечір</h3><p>1 день з PS5. Спробувати Вайс-Сіті й зрозуміти, чи затягне.</p><span class="num">{{ ps5.d1|zl }} zł</span></article>
        <article class="model reveal is-game"><h3 class="h3">GTA-вікенд</h3><p>2 дні: привеземо в п'ятницю, заберемо в неділю. Найпопулярніший варіант.</p><span class="num">{% if ps5.d2 %}{{ (ps5.d2 * 2)|zl }} zł{% else %}{{ ui.in_dm }}{% endif %}</span></article>
        <article class="model reveal is-game"><h3 class="h3">Пройти сюжет</h3><p>5 днів на PS5 — вистачить, щоб спокійно пройти основну історію.</p><span class="num">{% if ps5.d5 %}{{ ps5.d5|zl }} zł{% else %}{{ ui.in_dm }}{% endif %}</span></article>
      </div>
      <div class="deal reveal is-game">
        <b>Великий телевізор? Бери PS5 Pro</b>
        <span>Картинка чіткіша, FPS стабільніший. {{ pro.d1|zl }} zł за добу{% if pro.d2 %}, вихідні — {{ (pro.d2 * 2)|zl }} zł{% endif %}.</span>
      </div>
      <div class="btn-row reveal">
        {{ m.ig(settings, "Хочу GTA-вікенд", "ps5", "gta-pack", cls="btn btn-lime", icon=false) }}
        {{ m.ig(settings, "Хочу PS5 Pro з GTA VI", "ps5pro", "gta-pack", cls="btn btn-outline", icon=false) }}
      </div>
      <p class="prices-more reveal">Приставок з GTA VI обмежена кількість — перші вихідні після релізу бронюють заздалегідь. Зворотна застава — {{ P.console_deposit }} zł. <a href="{{ url('consoles') }}">Усі ціни на оренду PS5</a></p>
    </div>
  </section>

  <!-- ============ ОРЕНДА ЧИ КУПІВЛЯ ============ -->
  <section class="section" aria-labelledby="h-why">
    <div class="wrap">
      {{ m.head("Порахуємо", "Навіщо орендувати, а не купувати", "h-why") }}
      <ul class="why why-3 reveal">
        <li><b>Не треба 2500 zł</b><span>Нова PS5 плюс гра — це понад дві з половиною тисячі. Вихідні з GTA VI — {% if ps5.d2 %}{{ (ps5.d2 * 2)|zl }} zł{% else %}у рази дешевше{% endif %}.</span></li>
        <li><b>Не потрібна своя приставка</b><span>На PS4 GTA VI не вийде. Не треба оновлювати стару заради однієї гри.</span></li>
        <li><b>Не припадає пилом</b><span>Пройшов сюжет — ми забираємо. Захочеш ще — привеземо знову.</span></li>
      </ul>
    </div>
  </section>

  <!-- ============ ЯК ЦЕ ПРАЦЮЄ ============ -->
  <section class="section" id="yak-pratsyuye" aria-labelledby="h-how">
    <div class="wrap">
      {{ m.head("Як це працює", "Три кроки до Вайс-Сіті", "h-how") }}
      <ol class="steps">
        <li class="step reveal"><span class="step-n" aria-hidden="true">01</span><h3 class="h3">Пишеш в Instagram</h3><p>Дата, скільки днів і куди везти. Можна забронювати заздалегідь на {{ settings.gta_release }} і перші вихідні.</p></li>
        <li class="step reveal"><span class="step-n" aria-hidden="true">02</span><h3 class="h3">Привозимо й підключаємо</h3><p>PS5 з уже встановленою GTA VI — до телевізора й Wi‑Fi. Нічого завантажувати не треба.</p></li>
        <li class="step reveal"><span class="step-n" aria-hidden="true">03</span><h3 class="h3">Забираємо</h3><p>Коли скажеш. Хочеш дограти — продовжимо.</p></li>
      </ol>
    </div>
  </section>

  <!-- ============ КРОС-ПРОДАЖ ============ -->
  <section class="section section-flush" aria-label="Що ще можна взяти">
    <div class="wrap cross">
      <a class="cross-card is-game reveal" href="{{ url('games') }}"><span class="eyebrow is-game">На акаунті</span><b>Крім GTA VI — FC, Mortal Kombat, It Takes Two та інші</b><span class="link-arrow">Усі ігри</span></a>
      <a class="cross-card is-hookah reveal" href="{{ url('hookah') }}"><span class="eyebrow is-hookah">18+</span><b>GTA-вечір з кальяном — привеземо разом</b><span class="link-arrow">Кальян додому</span></a>
    </div>
  </section>

  {{ m.faq_section(faq, ui, title="Питання про оренду PS5 з GTA VI") }}

  <section class="section">
    <div class="wrap final reveal">
      <h2 class="h2">Вайс-Сіті чекає</h2>
      <p>Напиши дату — забронюємо PS5 з GTA VI.</p>
      {{ m.ig(settings, ui.book, "ps5", "final") }}
    </div>
  </section>
{% endblock %}
